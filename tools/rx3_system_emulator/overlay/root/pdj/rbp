#!/bin/sh

echo "RX3EMU: rbp exec $*"
export LD_PRELOAD=/root/pdj/rx3emu-fbshim.so
export RX3EMU_OUTPUT=/root/rx3emu
export RX3EMU_SEMIHOSTING=1
export DFBARGS=system=fbdev,no-vt,no-sighandler,no-cursor,no-hardware,disable-module=keyboard,disable-module=linux_input,disable-module=gal,mode=1280x720,depth=32

(
    elapsed=0
    while [ "$elapsed" -lt 60 ]; do
        if [ -s /root/rx3emu/framebuffer.raw ]; then
            bytes=`wc -c < /root/rx3emu/framebuffer.raw`
            echo "RX3EMU: framebuffer ready bytes=$bytes"
            exit 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
) &

exec /root/pdj/rbp.real "$@"
